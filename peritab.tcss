Screen {
    layout: vertical;
    height: 100%;
    width: 100%;
}

/* ── top-level split: table+plot on left, info panel on right ── */
.main {
    width: 100%;
    height: 1fr;
}

/* ── left column ── */
.table-section {
    width: 2fr;
    height: 100%;
    layout: vertical;
    overflow: auto;
    min-width: 36;
}

/* ── periodic grid: always 9 rows, scales with available height ── */
.periodic-grid {
    height: 36;          /* takes 2/3 of the left column */
    layout: grid;
    grid-size-columns: 18;
    grid-size-rows: 9;
    grid-gutter: 0 0;
    padding: 0;
    grid-rows: 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr;
    grid-columns: 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7;
}

/* ── element buttons ── */
Element {
    text-align: center;
    margin: 0;
    padding: 0;
    width: 5;
    height: 4;
    box-sizing: border-box;
}

NoElement {
    margin: 0;
    padding: 0;
    width: 1fr;
    height: 4;
    box-sizing: border-box;
}

/* ── plot row: 1fr so it takes the remaining left-column space ── */
.plot-area {
    height: 1fr;
    height: 16;
    width: 100%;
    layout: horizontal;
}

.plotting {
    width: 1fr;
    height: 100%;
    border: solid blue;
    padding: 0;
    background: #44444444;
}

/* ── compact energy-range controls beside the plot ── */
.plot-controls {
    width: 18;
    min-width: 16;
    height: 100%;
    border: solid green;
    padding: 0 1;
    background: #33333344;
}

.control-label {
    text-align: center;
    color: $text-primary;
}

.input-label {
    color: $text-secondary;
    height: 1;
}

.energy-input {
    color: white;
    background: transparent;
}

/* ── right panel ── */
TabbedContent.info {
    width: 1fr;
    height: 100%;
    min-width: 28;
    border: solid green;
    background: #22222244;
}

TabPane {
    padding: 0 0 0 0;
}

/* ── element info tab ── */
#tab-element VerticalScroll {
    width: 100%;
    height: 1fr;
}

MarkdownViewer {
    width: 100%;
    height: 1fr;
}

/* ── line search tab ── */

#tab-search {
    layout: vertical;
    padding: 1 1;
    overflow-y: auto;
}

.search-label {
    height: 1;
    color: $text-secondary;
}

.search-energy-input {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    color: $text-primary;
    background: $surface;
}

.family-cb {
    height: 3;
    padding: 0;
}

.line-search-table {
    width: 100%;
    height: 1fr;
    border: solid $accent;
}

/* ── element category colours ── */
.nobles           { border: round magenta;  color: magenta;  background: transparent; }
.metalloids       { border: round #48D1CC;  color: #48D1CC;  background: transparent; }
.nonmetals        { border: round #8FBC8F;  color: #8FBC8F;  background: transparent; }
.alkalimetals     { border: round #FFD700;  color: #FFD700;  background: transparent; }
.alkaliearthmetals{ border: round #FF8C00;  color: #FF8C00;  background: transparent; }
.posttransmetals  { border: round #FA8072;  color: #FA8072;  background: transparent; }
.transmetals      { border: round #FF4500;  color: #FF4500;  background: transparent; }
.lanthanoids      { border: round #F4A460;  color: #F4A460;  background: transparent; }
.actinoids        { border: round #DEB887;  color: #DEB887;background: transparent; }
.unknown          { border: round #708090;  color: #708090;  background: transparent; }


.group_lanthanoids{ border: round #F4A460;  background: transparent; }
.group_actinoids  { border: round #DEB887;  background: transparent; }
.empty            { background: transparent; }
.ERROR            { tint: red 40%; }
