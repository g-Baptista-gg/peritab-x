Screen {
    layout: vertical;
    padding: 0;
}

.main {
    width: 100%;
    height: 100%;
    layout: horizontal;
}

.periodic-grid {
    /* Use 1fr so it fills available vertical space rather than a fixed 60%
       which collapses cells on smaller terminals. */
    height: 1fr;
    layout: grid;
    grid-size-columns: 18;
    grid-size-rows: 7;
    grid-gutter: 0 0;
    padding: 0;
    /* 7 fractions — one per data row (was 10, mismatched grid-size-rows: 9) */
    grid-rows: 1fr 1fr 1fr 1fr 1fr 1fr 1fr;
    /* Never let the grid collapse so small that cell text vanishes */
    min-height: 14;
}

Element {
    text-align: center;
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    /* Single-line label (atomic number + symbol on one line) only needs
       2 rows minimum: 1 for the border + 1 for the text. */
    min-height: 2;
    overflow: hidden;
    box-sizing: border-box;
}

NoElement {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    min-height: 2;
    box-sizing: border-box;
}

/* categories */

.nobles {
    row-span: 1;
    column-span: 1;
    border: solid magenta;
    color: magenta;
    background: transparent;
}

.metalloids {
    row-span: 1;
    column-span: 1;
    border: solid #48D1CC;
    color: #48D1CC;
    background: transparent;
}

.nonmetals {
    row-span: 1;
    column-span: 1;
    border: solid #8FBC8F;
    color: #8FBC8F;
    background: transparent;
}

.alkalimetals {
    row-span: 1;
    column-span: 1;
    border: solid #FFD700;
    color: #FFD700;
    background: transparent;
}

.alkaliearthmetals {
    row-span: 1;
    column-span: 1;
    border: solid #FF8C00;
    color: #FF8C00;
    background: transparent;
}

.posttransmetals {
    row-span: 1;
    column-span: 1;
    border: round #FA8072;
    color: #FA8072;
    background: transparent;
}

.transmetals {
    row-span: 1;
    column-span: 1;
    border: solid #FF4500;
    color: #FF4500;
    background: transparent;
}

.unknown {
    row-span: 1;
    column-span: 1;
    border: solid #708090;
    color: #708090;
    background: transparent;
}

.group_lanthanoids {
    row-span: 1;
    column-span: 1;
    border: solid #F4A460;
    background: transparent;
}

.group_actinoids {
    row-span: 1;
    column-span: 1;
    border: solid #DEB887;
    background: transparent;
}

.empty {
    row-span: 1;
    column-span: 1;
    background: transparent;
}

.ERROR {
    tint: red 40%;
    row-span: 1;
    column-span: 1;
}

/* right-hand info panel */
.info {
    width: 40%;
    height: 100%;
    min-width: 30;
    border: solid green;
    padding: 1 1;
    text-align: left;
    background: #22222244;
    overflow: auto;
}

/* table section containing periodic table and plotting widget */
.table-section {
    width: 60%;
    height: 100%;
    layout: vertical;
    /* Allow both axes to scroll on very small terminals */
    overflow: auto;
    min-width: 40;
}

/* plot area containing plot and controls */
.plot-area {
    /* Fixed height so it doesn't steal space from the grid */
    height: 25;
    min-height: 20;
    width: 100%;
}

/* plotting widget */
.plotting {
    height: 100%;
    min-height: 20;
    border: solid blue;
    padding: 1 1;
    background: #44444444;
    text-align: center;
}

/* plot controls panel */
.plot-controls {
    width: 30;
    min-width: 25;
    /* Match the plot area height instead of a hardcoded 20 */
    height: 100%;
    border: solid green;
    padding: 1 1;
    margin-left: 1;
    background: #33333344;
}

.control-label {
    text-align: center;
    margin-bottom: 1;
    color: $text-primary;
}

.input-label {
    margin-top: 1;
    margin-bottom: 0;
    color: $text-secondary;
}

.energy-input {
    width: 100%;
    margin-bottom: 1;
}

.update-btn {
    width: 100%;
    margin-top: 1;
}
